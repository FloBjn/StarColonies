@page "{id}"
@model StarColonies.Web.Pages.UpdateObjectBonus

<h2>Modifier un objet bonus</h2>

<form method="post">
    <input type="hidden" asp-for="BonusObject.BonusObjectId" />

    <div class="form-group">
        <label asp-for="BonusObject.Name" class="control-label">Nom</label>
        <input asp-for="BonusObject.Name" class="form-control" />
        <span asp-validation-for="BonusObject.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BonusObject.Price" class="control-label">Prix</label>
        <input asp-for="BonusObject.Price" class="form-control" type="number" />
        <span asp-validation-for="BonusObject.Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BonusObject.BonusLevel" class="control-label">Niveau</label>
        <input asp-for="BonusObject.BonusLevel" class="form-control" type="number" />
        <span asp-validation-for="BonusObject.BonusLevel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BonusObject.BonusForce" class="control-label">Force</label>
        <input asp-for="BonusObject.BonusForce" class="form-control" type="number" />
        <span asp-validation-for="BonusObject.BonusForce" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BonusObject.BonusStamina" class="control-label">Endurance</label>
        <input asp-for="BonusObject.BonusStamina" class="form-control" type="number" />
        <span asp-validation-for="BonusObject.BonusStamina" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Modifier" class="btn btn-primary" />
        <a href="/TableBonusObject" class="btn btn-secondary">Annuler</a>
    </div>
</form>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
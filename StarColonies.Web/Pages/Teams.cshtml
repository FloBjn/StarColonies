@page
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.Entities
@model TeamsModel

@inject SignInManager<StarColoniesUser> SignInManager

@{
    ViewData["Title"] = "Tes équipes";
}
<h1 class="text-center mb-4 w-100">Vos équipes</h1>
<section class="w-100 d-flex">
    <div class="w-50 align-items-baseline d-flex">
        
        <form class="w-100 me-auto d-flex flex-wrap" method="post">
            @* choix equipe *@
            <label asp-for="InputModel.TeamId" class="form-label w-100">Choisir une équipe</label>
            <select onchange="onSelectChange()" id="TeamSelect" asp-for="InputModel.TeamId" class="form-control w-40" aria-required="true">
                <option value="">-- Choisir une équipe --</option>
                @foreach (var team in Model.Teams)
                {
                    <option value="@team.TeamId">@team.Name</option>
                }
            </select>
            <span asp-validation-for="InputModel.TeamId" class="text-danger ms-2"></span>
            <input type="hidden" asp-for="RedirectAction" value="Get"/>
            <button disabled id="ValidationSelect" type="submit" class="btn btn-primary w-auto">sélectionner</button>
            <script>
                function onSelectChange(){
                    const teamNameId = document.getElementById("TeamSelect").value;
                    document.getElementById("ValidationSelect").disabled = !teamNameId;
                }
            </script>
        </form>
    </div>
    
    <div class="w-50 align-items-baseline d-flex flex-wrap">
        <form class="w-100 ms-auto d-flex" method="post">
            <input type="hidden" asp-for="RedirectAction" value="Create"/>
            <button type="submit" asp-page="/TeamUpdate" class="btn btn-success ms-auto mt-auto w-auto">Créer une équipe</button>
        </form>
    </div>
</section>
@if (Model.SelectionedTeam!= null)
{
    <section class="w-100 d-flex flex-wrap mt-3">
        <h2 class="w-100 text-center text-decoration-underline">@Model.SelectionedTeam.Name</h2>
        <div class="d-flex align-content-around w-100 mt-4 mb-5">
            @if(Model.SelectionedTeam.ColonsTeam.Count > 0){
                foreach (var colon in Model.SelectionedTeam.ColonsTeam)
                {
                    <article class="w-20 d-flex flex-column p-1 m-auto">
                        <h4 class="text-center mb-3">@colon.Name</h4>
                        <div class="w-auto mx-auto mt-3">
                            <h5>Proffession : </h5>
                            <p>@colon.JobName</p>
                            <h5>Force : </h5>
                            <p>@colon.Force</p>
                            <h5>Endurance : </h5>
                            <p>@colon.Stamina</p>
                        </div>

                    </article>
                }
            }
        </div>
        <div class="d-flex ms-auto">
            <button type="button" class="btn btn-danger w-auto" id="deleteBtn">Supprimer équipe</button>
            <div id="avatarPopup" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center"
                 style="z-index: 1050;" hidden>
                <form method="post" class="p-0 w-auto ">
                    <p>Voulez-vous vraiment supprimer l'équipe ?</p>
                    <input type="hidden" asp-for="RedirectAction" value="Delete"/>
                    <button type="button" id="closeBtn" asp-page="/Teams" class="btn btn-danger w-auto">Annuler</button>
                    <button type="submit" id="confirmBtn" asp-page="/Teams" class="btn btn-primary w-auto ms-auto">Supprimer</button>

                </form>
            </div>
            
            <script>
                const popup = document.getElementById("avatarPopup");
                const openBtn = document.getElementById("deleteBtn");
                const cancelBtn = document.getElementById("closeBtn");
                if (openBtn && popup && cancelBtn) {
                    // Initialement, on cache le popup avec visibility et opacity
                    popup.style.visibility = 'hidden';
                    popup.style.opacity = '0';

                    // Affichage du popup avec une transition de 0.3 secondes
                    openBtn.addEventListener('click', () => {
                        popup.style.visibility = 'visible';
                        popup.style.opacity = '1'; // Affichage fluide
                    });

                    // Fermeture du popup
                    cancelBtn.addEventListener('click', () => {
                        popup.style.visibility = 'hidden';
                        popup.style.opacity = '0'; // Cache le popup
                    });
                }
            </script>
            
                <form method="post" class="p-0 w-auto ms-3 overflow-hidden">
                    <input type="hidden" asp-for="RedirectAction" value="Modify"/>
                    <button type="submit" id="deleteBtn" asp-page="/Teams" class="btn btn-primary w-auto">Modifier l'équipe</button>
                </form>
        </div>
        
        
        
    </section>
    }

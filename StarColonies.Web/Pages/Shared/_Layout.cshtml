@using Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - StarColonies</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true"/>
    <script src="~/js/site.js" defer></script>
</head>
<body class="text-white d-flex flex-column h-100">
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3 custom-navbar">

        <!-- Permet de reproduire le style de la navbar dans les maquettes -->
        <span class="corner top-left"></span>
        <span class="corner top-right"></span>
        <span class="corner bottom-left"></span>
        <span class="corner bottom-right"></span>
        
        <div class="container d-flex align-items-center py-3 w-100">
            <ul class="navbar-nav flex-row justify-content-evenly w-100 align-items-center">
                
                @await Html.PartialAsync("_Navbar")
            </ul>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3 d-flex flex-column align-items-center">
        @RenderBody()
    </main>
</div>

<footer class="mt-auto custom-footer text-center py-3 text-muted">
    <div class="container">
        &copy; 2025 - StarColonies - Romain, Maxime, Florence - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
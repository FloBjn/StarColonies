@page
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Domains
@using StarColonies.Infrastructures.Entities
@using StarColonies.Infrastructures.Mappers
@model CreateMissionModel

@inject SignInManager<StarColoniesUser> SignInManager

@{
ViewData["Title"] = "Create your mission";
}

<div class="container mission-creation-container">
    <h1>Create New Mission</h1>

    <form method="post">
        <!-- Mission Name Field -->
        <div class="form-floating mb-3">
            <input asp-for="InputModelInfos.MissionName" class="form-control" autocomplete="off" aria-required="true" placeholder=" " />
            <label asp-for="InputModelInfos.MissionName">Mission Name</label>
            <span asp-validation-for="InputModelInfos.MissionName" class="text-danger"></span>
        </div>

        <!-- Enemies Selection -->
        <div class="enemy-selection">
            @for (var i = 0; i < Model.Enemies.Count; i++)
            {
            <div class="enemy-item">
                <input asp-for="InputModelInfos.SelectedEnemiesId[i]" class="form-check-input" type="checkbox" value="@Model.Enemies[i].EnemyId" id="enemy-@i" />
                <label asp-for="InputModelInfos.SelectedEnemiesId[i]" class="enemy-name" for="enemy-@i">
                    @Model.Enemies[i].Name
                </label>
                <div class="enemy-stats">
                    <span>Force: @Model.Enemies[i].Force</span>
                    <span>Endurance: @Model.Enemies[i].Stamina</span>
                </div>
            </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Create Mission</button>
    </form>
</div>
<style>
    .mission-creation-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: #15181B;
        border-radius: 1em;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
        color: #eee;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .mission-creation-container h1 {
        color: #fff;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 2.5rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .mission-creation-container form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .mission-creation-container .form-floating {
        position: relative;
    }

    .mission-creation-container .form-control {
        background-color: #0C0F12;
        border: 1px solid #391C3B;
        color: #fff;
        padding: 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .mission-creation-container .form-control:focus {
        background-color: #0C0F12;
        color: #fff;
        border-color: #6a3093;
        box-shadow: 0 0 0 0.25rem rgba(106, 48, 147, 0.25);
    }
    .mission-creation-container .form-check-input {
        width: 1.2em;
        height: 1.2em;
        margin-right: 0.5rem;
        background-color: #0C0F12;
        border: 1px solid #6a3093;
    }

    .mission-creation-container .form-check-input:checked {
        background-color: #6a3093;
        border-color: #6a3093;
    }

    .mission-creation-container .text-danger {
        color: #dc3545;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .mission-creation-container.btn-primary {
        background-color: #391C3B;
        border: none;
        padding: 0.8rem 2rem;
        font-size: 1.1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: all 0.3s ease;
        align-self: center;
        margin-top: 1rem;
    }

    .mission-creation-container .btn-primary:hover {
        background-color: #4d2554;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(57, 28, 59, 0.4);
    }


    .mission-creation-container .enemy-selection {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1rem;
    }

    .mission-creation-container .enemy-item {
        flex: 1 1 calc(33% - 1rem);
        min-width: 250px;
        background-color: #1E2124;
        padding: 1rem;
        border-radius: 0.5rem;
        border-left: 3px solid #6a3093;
        transition: all 0.3s ease;
    }

    .mission-creation-container .enemy-item:hover {
        background-color: #25282B;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .mission-creation-container .enemy-name {
        font-weight: bold;
        color: #fff;
        margin-bottom: 0.5rem;
    }

    .mission-creation-container .enemy-stats {
        display: flex;
        justify-content: space-between;
        color: #aaa;
        font-size: 0.9rem;
    }
    
</style>
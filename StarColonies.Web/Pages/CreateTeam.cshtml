@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.Mappers
@model CreateTeam

@{
    ViewData["Title"] = "Create your team";
}
<h1 class="text-center mb-4 w-100">Création de ton équipe</h1>
<div class="d-flex w-100">
    <a asp-page="/Teams" asp-route-id="" class="btn btn-primary w-auto me-auto">Retour</a>
</div>

<section class="w-100 d-flex flex-wrap mt-3">
    <form class="w-100 d-flex flex-wrap mx-auto" id="formInfos" method="post" asp-page-handler="SubmitTeam">
        <div class="d-flex w-100 align-items-end mb-3">
            @* Nom équipe *@
            <div class="form-floating mb-3 w-auto me-5">
                <input asp-for="InputTeamInfos.TeamName" class="form-control" autocomplete="username" aria-required="true" value="@Model.ModifyingTeam?.Name"/>
                <label asp-for="InputTeamInfos.TeamName" class="form-label text-black">Nom de l'équipe</label>
                <span asp-validation-for="InputTeamInfos.TeamName" class="text-danger"></span>
            </div>
            @* Baniere *@
            <div class="mb-3">
                <label asp-for="InputTeamInfos.Banner" class="form-label">Choisissez une bannière</label>
                <input asp-for="InputTeamInfos.Banner" type="file" class="form-control" id="avatarInput"/>
                <span asp-validation-for="InputTeamInfos.Banner" class="text-danger"></span>
            </div>
            <img id="preview" class="img-thumbnail ms-3" style="display:none; max-height:100px;" />

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    setupImagePreview('avatarInput','preview');
                });
            </script>
        </div>
        <div class="d-flex align-content-around w-100 mt-4 mb-5">
            @for (var i = 0; i < 4; i++)
            {
                <article class="w-100 d-flex flex-column p-1 m-auto">
                    <h4 class="text-center mb-3">Colon @(i+1)</h4>
                    <div class="w-auto mx-auto mt-3">
                        <input type="hidden" asp-for="ColonModelList[i].ColonId"/>
                        @* Nom *@
                        <div class="form-floating mb-3 w-100">
                            <input asp-for="ColonModelList[i].Name" class="form-control" autocomplete="username" aria-required="true" value="@Model.ColonModelList[i].Name"/>
                            <label asp-for="ColonModelList[i].Name" class="form-label text-black">Nom du colon</label>
                            <span asp-validation-for="ColonModelList[i].Name" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <select asp-for="ColonModelList[i].ProfessionId" class="form-control" aria-required="true">
                                @* <option value="@profId" selected="selected"></option> *@
                                <option value="0">Ingénieur</option>
                                <option value="1">Soldat</option>
                                <option value="2">Scientifique</option>
                                <option value="3">Medecin</option>
                            </select>
                            <label asp-for="ColonModelList[i].ProfessionId" class="form-label text-black fs-6">Profession</label>
                            <span asp-validation-for="ColonModelList[i].ProfessionId" class="text-danger"></span>
                        </div>
                        @* Force *@
                        <div class="form-floating mb-3">
                            <input asp-for="ColonModelList[i].Force" type="number" min="0" max="7" class="form-control" aria-required="true" value="@Model.ColonModelList[i].Force"/>
                            <label asp-for="ColonModelList[i].Force" class="form-label text-black">Force</label>
                            <span asp-validation-for="ColonModelList[i].Force" class="text-danger"></span>
                        </div>
                        @* Endurance *@
                        <div class="form-floating mb-3">
                            <input asp-for="ColonModelList[i].Endurance" type="number" min="0" max="7" class="form-control" aria-required="true" value="@Model.ColonModelList[i].Endurance"/>
                            <label asp-for="ColonModelList[i].Endurance" class="form-label text-black">Endurance</label>
                            <span asp-validation-for="ColonModelList[i].Endurance" class="text-danger"></span>
                        </div>
                    </div>

                </article>
            }
            <article class="w-100 d-flex flex-column p-1 m-auto">
                <h4 class="text-center mb-3">Colon 5</h4>
                <div class="w-auto mx-auto mt-3">
                    @* Nom *@
                    <div class="form-floating mb-3 w-100">
                        <input asp-for="OptionalColon.Name" class="form-control" autocomplete="username" aria-required="true" value="@Model.OptionalColon.Name"/>
                        <label asp-for="OptionalColon.Name" class="form-label text-black">Nom du colon</label>
                        <span asp-validation-for="OptionalColon.Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="OptionalColon.ProfessionId" class="form-control" aria-required="true" >
                            @* <option value="@profId" selected="selected"></option> *@
                            <option value="0">Ingénieur</option>
                            <option value="1">Soldat</option>
                            <option value="2">Scientifique</option>
                            <option value="3">Medecin</option>
                        </select>
                        <label asp-for="OptionalColon.ProfessionId" class="form-label text-black fs-6">Profession</label>
                        <span asp-validation-for="OptionalColon.ProfessionId" class="text-danger"></span>
                    </div>
                    @* Force *@
                    <div class="form-floating mb-3">
                        <input asp-for="OptionalColon.Force" type="number" min="0" max="7" class="form-control" aria-required="true" value="@Model.OptionalColon.Force"/>
                        <label asp-for="OptionalColon.Force" class="form-label text-black">Force</label>
                        <span asp-validation-for="OptionalColon.Force" class="text-danger"></span>
                    </div>
                    @* Endurance *@
                    <div class="form-floating mb-3">
                        <input asp-for="OptionalColon.Endurance" type="number" min="0" max="7" class="form-control" aria-required="true" value="@Model.OptionalColon.Endurance"/>
                        <label asp-for="OptionalColon.Endurance" class="form-label text-black">Endurance</label>
                        <span asp-validation-for="OptionalColon.Endurance" class="text-danger"></span>
                    </div>
                </div>

            </article>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3 w-100">
            <button type="button" class="btn btn-danger" id="cancelBtn">↩️ Annuler</button>
            <button type="submit" class="btn btn-primary" id="saveBtn">💾 Enregistrer</button>
        </div>
    </form>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        setupFormWatcher("formInfos", "saveBtn", "cancelBtn");
        setupFormWatcher("formColon0", "btnSave0", "btnCancel0");
        setupFormWatcher("formColon1", "btnSave1", "btnCancel1");
        setupFormWatcher("formColon2", "btnSave2", "btnCancel2");
        setupFormWatcher("formColon3", "btnSave3", "btnCancel3");
        setupFormWatcher("formColon4", "btnSave4", "btnCancel4");
    });
</script>

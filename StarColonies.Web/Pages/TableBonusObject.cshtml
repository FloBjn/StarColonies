@page
@model StarColonies.Web.Pages.TableBonusObject

<h2>Liste des objets bonus
    <a asp-page="/CreateObjectBonus" class="btn btn-primary">Ajouter</a>
</h2>

<table class="table">
    <thead>
    <tr>
        <th>Nom</th>
        <th>Prix</th>
        <th>Niveau</th>
        <th>Force</th>
        <th>Endurance</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var obj in await Model.GetAllBonusObejcts() )
    {
        <tr>
            <td>@obj.Name</td>
            <td>@obj.Price</td>
            <td>@obj.BonusLevel</td>
            <td>@obj.BonusForce</td>
            <td>@obj.BonusStamina</td>
            <td>
                <a asp-page="/UpdateObjectBonus" asp-route-id="@obj.BonusObjectId" class="btn btn-sm btn-warning">Modifier</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@obj.BonusObjectId" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet objet?');" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
<style>
    h2 {
        color: #7cb8ff;
        text-shadow: 0 0 10px rgba(124, 184, 255, 0.5);
        margin-bottom: 1.5rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        border-bottom: 2px solid rgba(124, 184, 255, 0.3);
        padding-bottom: 0.5rem;
    }
    
    .table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 1.5rem 0;
        background-color: rgba(20, 25, 32, 0.8);
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(124, 184, 255, 0.1);
    }

    .table thead {
        background: linear-gradient(90deg, #1a2a3a 0%, #2a3a4a 100%);
        color: #7cb8ff;
        text-transform: uppercase;
        letter-spacing: 0.15em;
    }

    .table th {
        padding: 1rem;
        text-align: left;
        border-bottom: 2px solid #7cb8ff;
    }

    .table td {
        padding: 1rem;
        color: #c7d9f5;
        border-bottom: 1px solid rgba(124, 184, 255, 0.1);
        vertical-align: middle;
    }

    .table tbody tr:last-child td {
        border-bottom: none;
    }

    .table tbody tr:hover {
        background-color: rgba(124, 184, 255, 0.05);
    }
    
    .btn {
        font-family: 'Upheaval TT', sans-serif;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: all 0.3s ease;
        border: none;
        position: relative;
        overflow: hidden;
    }

    .btn-primary {
        background-color: #3a4b6b;
        border: 1px solid #7cb8ff;
        color: #7cb8ff;
    }

    .btn-primary:hover {
        background-color: #4a5b7b;
        box-shadow: 0 0 10px rgba(124, 184, 255, 0.5);
        transform: translateY(-2px);
    }

    .btn-warning {
        background-color: #6b5b3a;
        border: 1px solid #ffd37c;
        color: #ffd37c;
    }

    .btn-warning:hover {
        background-color: #7b6b4a;
        box-shadow: 0 0 10px rgba(255, 211, 124, 0.5);
        transform: translateY(-2px);
    }

    .btn-danger {
        background-color: #6b3a3a;
        border: 1px solid #ff7c7c;
        color: #ff7c7c;
    }

    .btn-danger:hover {
        background-color: #7b4a4a;
        box-shadow: 0 0 10px rgba(255, 124, 124, 0.5);
        transform: translateY(-2px);
    }
    
    td {
        position: relative;
    }

    td::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, rgba(124, 184, 255, 0.05) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    td:hover::before {
        opacity: 1;
    }

</style>
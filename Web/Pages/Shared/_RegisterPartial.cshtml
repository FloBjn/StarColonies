@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.data.Entities

@inject SignInManager<StarColoniesUser> SignInManager
@inject UserManager<StarColoniesUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Bonjour @UserManager.GetUserName(User)!</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white fs-5 fw-bold" id="register" asp-area="Identity" asp-page="/Account/Register">S'INSCRIRE</a>
    </li>
}
</ul>

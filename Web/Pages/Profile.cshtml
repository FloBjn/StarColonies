@page
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.Entities
@model ProfileModel

@inject SignInManager<StarColoniesUser> SignInManager

@{
    ViewData["Title"] = "Profil";
}
@if (SignInManager.IsSignedIn(User))
{
    <div class="position-relative text-center mb-4 w-100">
        <div class="flex-fill text-center">
            <h1 class="m-0">Votre profil @Model.UserConnected?.UserColon.Name</h1>
        </div>
        <form id="logoutForm" class="position-absolute top-0 end-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button id="logout" type="submit" class="w-100 btn btn-lg custom-disc-button">DECONNEXION</button>
        </form>
    </div>
    

    <section class="w-100 d-flex mb-xl-5 align-items-baseline">
        <section class="w-50 d-flex flex-wrap ps-1">
            <h2 class="w-100 text-center mb-5">Avatar</h2>
            <div class="w-100 d-flex mb-3">
                <img src="@Model.UserConnected?.Avatar" class="img-fluid img-avatar m-md-auto rounded-3"/>    
            </div>
            <button id="modifyAvatar" type="button" class="w-25 btn btn-primary btn-sm m-auto">Modifier</button>

            <!-- Popup avatar form -->
            <div id="avatarPopup" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center"
                 style="z-index: 1050;" hidden>
                <div class="bg-white p-4 rounded-3 shadow w-25" @*style="width: 400px; max-width: 90%;"*@>
                    <form method="post" enctype="multipart/form-data" id="avatarForm">
                        <h5 class="mb-3 text-black">Modifier votre avatar</h5>

                        <div class="mb-3">
                            <input asp-for="InputAvatar.Avatar" type="file" class="form-control image-input" data-preview-id="preview" id="avatarInput"/>
                            <span asp-validation-for="InputAvatar.Avatar" class="text-danger"></span>
                        </div>
                        <img id="preview" class="img-thumbnail mb-3" style="display:none; max-height:150px;" />

                        <div class="d-flex justify-content-between mt-3">
                            <button type="button" class="btn btn-danger" id="cancelAvatarPopup">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    
        <section class="w-50 d-flex flex-wrap ps-5 border-start border-2 border-white">
            <h2 class="w-100 text-center mb-5">Infos personnelles</h2>
            <form class="mb-5 d-flex flex-wrap w-75 mx-auto" id="PersonalInfosForm" method="post">
                @* name field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="InputPersonal.FirstName" class="form-control" autocomplete="username" aria-required="true" value="@Model.UserConnected?.UserColon.Name" />
                    <label asp-for="InputPersonal.FirstName" class="form-label text-black">Votre pseudo</label>
                    <span asp-validation-for="InputPersonal.FirstName" class="text-danger"></span>
                </div>
                @* date naissance field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="InputPersonal.BirthDate" class="form-control" type="date" aria-required="true" value="@Model.BirthDateFormatted"/>
                    <label asp-for="InputPersonal.BirthDate" class="form-label text-black">Votre date de naissance</label>
                    <span asp-validation-for="InputPersonal.BirthDate" class="text-danger"></span>
                </div>
                @* email field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="InputPersonal.Email" class="form-control" autocomplete="username" aria-required="true" value="@Model.UserConnected?.Email" />
                    <label asp-for="InputPersonal.Email" class="form-label text-black">Email</label>
                    <span asp-validation-for="InputPersonal.Email" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3 w-100">
                    <button type="button" class="btn btn-danger" id="persocancelBtn" disabled>↩️ Annuler</button>
                    <button type="submit" class="btn btn-primary" id="persosaveBtn" disabled>💾 Enregistrer</button>
                </div>
            </form>

            <h2 class="w-100 text-center mb-5">Infos sur ton colon</h2>
            
            <form class="d-flex flex-wrap justify-content-between w-75 mx-auto" id="ColonInfoForm" method="post">
                @* Proffession field *@
                <div class="form-floating mb-3 w-100">
                    <select asp-for="InputColon.Profession" class="form-control" aria-required="true">
                        <option value="">-- Choisir une profession --</option>
                        <option value="Ingénieur">Ingénieur</option>
                        <option value="Médecin">Médecin</option>
                        <option value="Explorateur">Explorateur</option>
                    </select>
                    <label asp-for="InputColon.Profession" class="form-label text-black">Choisir une proffession</label>
                    <span asp-validation-for="InputColon.Profession" class="text-danger"></span>
                </div>
                @* Force field *@
                <div class="form-floating mb-3 w-40">
                    <input asp-for="InputColon.Force" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
                    <label asp-for="InputColon.Force" class=" text-black">Force</label>
                    <span asp-validation-for="InputColon.Force" class="text-danger"></span>
                </div>
                @* Endurance field *@
                <div class="form-floating mb-3 w-40">
                    <input asp-for="InputColon.Endurance" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
                    <label asp-for="InputColon.Endurance" class="form-label text-black">Endurance</label>
                    <span asp-validation-for="InputColon.Endurance" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="d-flex justify-content-end gap-2 mt-3 w-100">
                    <button type="button" class="btn btn-danger" id="coloncancelBtn" disabled>↩️ Annuler</button>
                    <button type="submit" class="btn btn-primary" id="colonsaveBtn" disabled>💾 Enregistrer</button>
                </div>
            </form>

        </section>

    </section>
   
    <script>
    

    // Appelle la fonction pour chaque formulaire
    document.addEventListener("DOMContentLoaded", function () {
        setupFormWatcher("PersonalInfosForm", "persosaveBtn", "persocancelBtn");
        setupFormWatcher("ColonInfoForm", "colonsaveBtn", "coloncancelBtn");
        togglePopup('modifyAvatar', 'avatarPopup', 'cancelAvatarPopup', 'avatarInput', 'preview');
        setupImagePreview('avatarInput','preview');
        setupFormSubmission('avatarForm');
        setupFormSubmission('PersonalInfosForm');
        setupFormSubmission('ColonInfoForm');
    });
</script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    
}


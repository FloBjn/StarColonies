@page
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.data.Entities
@model ProfileModel

@inject SignInManager<StarColoniesUser> SignInManager

@{
    ViewData["Title"] = "Profil";
}
@if (SignInManager.IsSignedIn(User))
{
    <div class="position-relative text-center mb-4 w-100">
        <div class="flex-fill text-center">
            <h1 class="m-0">Votre profil @Model.UserConnected?.FirstName</h1>
        </div>
        <form id="logoutForm" class="position-absolute top-0 end-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button id="logout" type="submit" class="w-100 btn btn-lg custom-disc-button">DECONNEXION</button>
        </form>
    </div>
    

    <section class="w-100 d-flex mb-xl-5 align-items-baseline">
        <section class="w-50 d-flex flex-wrap ps-1">
            <h2 class="w-100 text-center mb-5">Avatar</h2>
            <div class="w-100 d-flex mb-3">
                <img src="@Model.UserConnected?.Avatar" class="img-fluid img-avatar m-md-auto rounded-3"/>    
            </div>
            <button id="modifyAvatar" type="button" class="w-25 btn btn-primary btn-sm m-auto">Modifier</button>
        </section>
    
        <section class="w-50 d-flex flex-wrap ps-5 border-start border-2 border-white">
            <h2 class="w-100 text-center mb-5">Infos personnelles</h2>
            <form class="mb-5 d-flex flex-wrap w-75 mx-auto" id="PersonalInfosForm">
                @* name field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="Input.FirstName" class="form-control" autocomplete="username" aria-required="true" value="@Model.UserConnected?.FirstName" />
                    <label asp-for="Input.FirstName" class="form-label text-black">Votre pseudo</label>
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                @* date naissance field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="Input.BirthDate" class="form-control" type="date" aria-required="true" value="@Model.BirthDateFormatted"/>
                    <label asp-for="Input.BirthDate" class="form-label text-black">Votre date de naissance</label>
                    <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
                </div>
                @* email field *@
                <div class="form-floating mb-3 w-100">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" value="@Model.UserConnected?.Email" />
                    <label asp-for="Input.Email" class="form-label text-black">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3 w-100">
                    <button type="button" class="btn btn-danger" id="persocancelBtn" disabled>↩️ Annuler</button>
                    <button type="submit" class="btn btn-primary" id="persosaveBtn" disabled>💾 Enregistrer</button>
                </div>
            </form>

            <h2 class="w-100 text-center mb-4">Infos de ton colon</h2>
            
            <form class="d-flex flex-wrap justify-content-between w-75 mx-auto" id="ColonInfoForm">
                @* Proffession field *@
                <div class="form-floating mb-3 w-100">
                    <select asp-for="Input.Profession" class="form-control" aria-required="true">
                        <option value="">-- Choisir une profession --</option>
                        <option value="Ingénieur">Ingénieur</option>
                        <option value="Médecin">Médecin</option>
                        <option value="Explorateur">Explorateur</option>
                    </select>
                    <label asp-for="Input.Profession" class="form-label text-black">Choisir une proffession</label>
                    <span asp-validation-for="Input.Profession" class="text-danger"></span>
                </div>
                @* Force field *@
                <div class="form-floating mb-3 w-40">
                    <input asp-for="Input.Force" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
                    <label asp-for="Input.Force" class=" text-black">Force</label>
                    <span asp-validation-for="Input.Force" class="text-danger"></span>
                </div>
                @* Endurance field *@
                <div class="form-floating mb-3 w-40">
                    <input asp-for="Input.Endurance" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
                    <label asp-for="Input.Endurance" class="form-label text-black">Endurance</label>
                    <span asp-validation-for="Input.Endurance" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="d-flex justify-content-end gap-2 mt-3 w-100">
                    <button type="button" class="btn btn-danger" id="coloncancelBtn" disabled>↩️ Annuler</button>
                    <button type="submit" class="btn btn-primary" id="colonsaveBtn" disabled>💾 Enregistrer</button>
                </div>
            </form>

        </section>

    </section>
   
    <script>
    function setupFormWatcher(formId, saveBtnId, cancelBtnId) {
        const form = document.getElementById(formId);
        const inputs = form.querySelectorAll("input");
        const saveBtn = document.getElementById(saveBtnId);
        const cancelBtn = document.getElementById(cancelBtnId);

        const initialValues = {};
        inputs.forEach(input => {
            initialValues[input.name] = input.value;
        });

        function checkForChanges() {
            let hasChanged = false;
            inputs.forEach(input => {
                const currentValue = input.value;
                const originalValue = initialValues[input.name];
                if (currentValue !== originalValue) {
                    hasChanged = true;
                    input.classList.add("changed-field");
                } else {
                    input.classList.remove("changed-field");
                }
            });
            saveBtn.disabled = !hasChanged;
            cancelBtn.disabled = !hasChanged;
        }

        inputs.forEach(input => {
            input.addEventListener("input", checkForChanges);
        });

        cancelBtn.addEventListener("click", () => {
            inputs.forEach(input => {
                input.value = initialValues[input.name];
                input.classList.remove("changed-field");
            });
            saveBtn.disabled = true;
            cancelBtn.disabled = true;
        });
    }

    // Appelle la fonction pour chaque formulaire
    document.addEventListener("DOMContentLoaded", function () {
        setupFormWatcher("PersonalInfosForm", "persosaveBtn", "persocancelBtn");
        setupFormWatcher("ColonInfoForm", "colonsaveBtn", "coloncancelBtn");
    });
</script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    
}


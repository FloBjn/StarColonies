@page
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using StarColonies.Infrastructures.Entities
@model TeamsModel

@inject SignInManager<StarColoniesUser> SignInManager

@{
    ViewData["Title"] = "Teams";
}
<h1 class="text-center mb-4 w-100">Vos équipes</h1>
<section class="w-100">
    <div class="w-50">
        <p>Choisir une équipe</p>
        <form>
            @* choix equipe *@
            <div class="form-floating mb-3 w-100">
                        <select asp-for="InputModel.TeamName" class="form-control" aria-required="true">
                            <option value="">-- Choisir une profession --</option>
                            @foreach (var teamName in Model.TeamsNames)
                            {
                                <option value="Ingénieur">@teamName</option>
                            }
                            <option value="Médecin">Equipe 2</option>
                            <option value="Explorateur">Equipe 3</option>
                        </select>
                        <label asp-for="InputModel.TeamName" class="form-label text-black">Choisir une équipe</label>
                        <span asp-validation-for="InputModel.TeamName" class="text-danger"></span>
                    </div>
        </form>
    </div>
    
    <div class="w-50">
        <a asp-area="" asp-page="/TeamCreation" class="btn btn-primary">Aller sur l'autre page</a>
    </div>
</section>

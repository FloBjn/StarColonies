@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Bienvenue dans StarColonies</h1>
    
    <section class="container d-flex flex-row justify-content-evenly mt-5">
        <img src="css/images/552220111.gif" alt="Blackhole" class="animated-blackhole">
        
        <div class="d-flex flex-column w-50 justify-content-center">
            <h2>Qui sommes nous ?</h2>

            <p>
                Bienvenue dans l’univers captivant de StarColonies: The Age of Middleware, le tout nouveau
                jeu d’aventure futuriste signé Laudrikx Games, un studio reconnu pour ses chefs-d’œuvre en
                stratégie et science-fiction. Plongez dans une expérience qui combine subtilement gestion de
                ressources et jeu de rôle, où chaque décision compte.
                Dans StarColonies, vous incarnez un colon intrépide, représenté sous forme de carte évolutive,
                prêt à braver les dangers d’une planète inconnue. Votre mission ? Explorer, développer et
                survivre dans un environnement hostile
            </p>
        </div>
    </section>
    
    <section class="container d-flex flex-column mt-5">
        <h2>LeaderBoard</h2>
        <table class="table table-dark table-striped">
            <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Score</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <th scope="row">1</th>
                <td>Les loosers</td>
                <td>2235</td>
            </tr>
            <tr>
                <th scope="row">2</th>
                <td>FoxHound</td>
                <td>2106</td>
            </tr>
            <tr>
                <th scope="row">3</th>
                <td>VIMeurs</td>
                <td>2056</td>
            </tr>
            </tbody>
        </table>
    </section>
</div>
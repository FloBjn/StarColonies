@page
@model RegisterModel
@{
    ViewData["Title"] = "S'enregistrer";
}

<h1>Créer ton compte StarColonies</h1>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" class="custom-form m-5">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    @* name field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.FirstName" class="form-control" autocomplete="username" aria-required="true" placeholder="your name" />
        <label asp-for="Input.FirstName" class="form-label text-black">Votre pseudo</label>
        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
    </div>
    @* date naissance field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.BirthDate" class="form-control" type="date" aria-required="true"/>
        <label asp-for="Input.BirthDate" class="form-label text-black">Votre date de naissance</label>
        <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
    </div>
    @* email field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email" class="form-label text-black">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    @* password field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.Password" class="form-label text-black">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    @* password confirm field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.ConfirmPassword" class="form-label text-black">Confirm Password</label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    @* Avatar field *@
    <div class="mb-3">
        <label asp-for="Input.Avatar" class="form-label">Votre avatar</label>
        <input asp-for="Input.Avatar" type="file" class="form-control" />
        <span asp-validation-for="Input.Avatar" class="text-danger"></span>
    </div>
    <img id="preview" class="img-thumbnail mb-2" style="display:none; max-height:150px;" />

    <script>
        document.querySelector('#Input_Avatar').addEventListener('change', function (e) {
            const preview = document.getElementById('preview');
            const file = e.target.files[0];
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            }
        });
    </script>
    <h3>Infos sur ton Colon</h3>
    @* Proffession field *@
    <div class="form-floating mb-3">
        <select asp-for="Input.Profession" class="form-control" aria-required="true">
            <option value="">-- Choisir une profession --</option>
            <option value="Ingénieur">Ingénieur</option>
            <option value="Médecin">Médecin</option>
            <option value="Explorateur">Explorateur</option>
        </select>
        <label asp-for="Input.Profession" class="form-label text-black">Choisir une proffession</label>
        <span asp-validation-for="Input.Profession" class="text-danger"></span>
    </div>
    @* Force field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.Force" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
        <label asp-for="Input.Force" class="form-label text-black">Point de compétence Force</label>
        <span asp-validation-for="Input.Force" class="text-danger"></span>
    </div>
    @* Endurance field *@
    <div class="form-floating mb-3">
        <input asp-for="Input.Endurance" type="number" min="0" max="7" class="form-control" aria-required="true" placeholder="0"/>
        <label asp-for="Input.Endurance" class="form-label text-black">Point de compétence Endurance</label>
        <span asp-validation-for="Input.Endurance" class="text-danger"></span>
    </div>
    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">S'enregistrer</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

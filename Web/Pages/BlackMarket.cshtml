@page
@model BlackMarket

<div class="header-comptoir">
    <img src="css/images/marchand.png" alt="Marchand" class="image-marchand" />
    <h1>Marché Noir</h1>
    <div class="ressources-container">
        <p class="ressources-text">Ressources : @Model.UserColon?.NumberResource</p>
        <img src="css/images/ressource.png" alt="Ressource" class="ressource-image"/>
    </div>
</div>
<div class="comptoir">
    @foreach (var bonus in (await Model.GetAllMissions())
              .Where(b => !Model.Team.TeamBonusObjects.Any(tbo => tbo.BonusObjectId == b.BonusObjectId)))
    {
        <div class="objet-card">
            <div class="objet-content">
                <div class="objet-details">
                    <h3>@bonus.Name</h3>
                    <ul class="bonus-list">
                        @if (bonus.BonusLevel > 0)
                        {
                            <li>Bonus Niveau : @bonus.BonusLevel</li>
                        }
                        @if (bonus.BonusForce > 0)
                        {
                            <li>Bonus Force : @bonus.BonusForce</li>
                        }
                        @if (bonus.BonusStamina > 0)
                        {
                            <li>Bonus Endurance : @bonus.BonusStamina</li>
                        }
                    </ul>
                    <p>Prix : @bonus.Price</p>
                    <form method="post">
                        <input type="hidden" name="objetId" value="@bonus.BonusObjectId" />
                        <button type="submit">Acheter</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if ('@TempData["Error"]' !== '') {
            alert('@TempData["Error"]');
        }
        if ('@TempData["Success"]' !== '') {
            alert('@TempData["Success"]');
        }
    });
</script>
}
<style>
    .header-comptoir {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
        color: #fff;
        text-align: center;
    }

    .ressources-container {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .image-marchand {
        width: 120px;
        height: auto;
        border-radius: 12px;
        margin-bottom: 10px;
    }

    .ressources-text {
        margin: 0; 
        line-height: 24px;
    }
    .ressource-image {
        width: 24px;
        height: 24px;
        vertical-align: middle;
        margin-top: -2px;
        border-radius: 50%;
    }

    .comptoir {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
        padding: 0 20px;
    }

    .objet-card {
        background-color: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        width: 300px;
        color: #eee;
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .objet-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.3);
    }

    .objet-content {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 20px;
    }

    .objet-details {
        flex-grow: 1;
        text-align: center;
    }

    .objet-details h3 {
        margin: 0 0 10px 0;
        color: #f8f9fa;
        font-size: 1.4rem;
    }

    .bonus-list {
        list-style: none;
        padding: 0;
        margin: 15px 0;
        text-align: left;
        display: inline-block;
    }

    .bonus-list li {
        margin-bottom: 8px;
        padding-left: 20px;
        position: relative;
    }

    .bonus-list li:before {
        content: "•";
        color: #28a745;
        position: absolute;
        left: 0;
    }

    .objet-details p {
        margin: 15px 0;
        font-size: 1.2rem;
        color: #ffc107;
    }

    button {
        margin-top: auto;
        padding: 10px 20px;
        border: none;
        background-color: #28a745;
        color: white;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
        transition: background-color 0.3s;
    }

    button:hover {
        background-color: #218838;
    }
</style>
@page
@model StarColonies.Web.Pages.Test1

@{
int? missionId = null;
bool? resultatMission = null;

if (Request.Method == "POST")
{
    if (int.TryParse(Request.Form["missionId"], out var id))
    {
        missionId = id;
        var rand = new Random();
        resultatMission = rand.Next(0, 2) == 0; // 50% de chance de succès
    }
}

var missions = new List<dynamic>
{
    new {
        Id = 1,
        Nom = "Mission Alpha",
        Niveau = 1,
        Monstres = new List<dynamic>
        {
            new { Nom = "Gobelin", Force = 5, Endurance = 3 },
            new { Nom = "Loup", Force = 6, Endurance = 4 }
        }
    },
    new {
        Id = 2,
        Nom = "Mission Beta",
        Niveau = 3,
        Monstres = new List<dynamic>
        {
            new { Nom = "Orc", Force = 10, Endurance = 8 },
            new { Nom = "Troll", Force = 12, Endurance = 10 }
        }
    },
    new {
        Id = 3,
        Nom = "Mission Gamma",
        Niveau = 5,
        Monstres = new List<dynamic>
        {
            new { Nom = "Dragon", Force = 20, Endurance = 15 },
            new { Nom = "Démon", Force = 18, Endurance = 14 }
        }
    }
};
}

<div class="missions">
    @foreach (var mission in missions)
    {
        <details class="mission-block" @(missionId == mission.Id ? "open" : "")>
            <summary class="mission-header">
                <strong>@mission.Nom</strong> — Niveau : @mission.Niveau
            </summary>
            <div class="mission-details">
                <ul>
                    @foreach (var monstre in mission.Monstres)
                    {
                        <li><strong>@monstre.Nom</strong> — Force : @monstre.Force, Endurance : @monstre.Endurance</li>
                    }
                </ul>

                <form method="post">
                    <input type="hidden" name="missionId" value="@mission.Id" />
                    <button type="submit">Lancer la mission</button>
                </form>

                @if (missionId == mission.Id && resultatMission.HasValue)
                {
                    if (resultatMission.Value)
                    {
                        <div class="result-box success">✅ Tu as réussi la mission !</div>
                    }
                    else
                    {
                        <div class="result-box failure">💀 Tu es mort. Retente ta chance !</div>
                    }
                }
            </div>
        </details>
    }
</div>

<style>
    .missions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 40px;
    }

    details.mission-block {
        background-color: #15181B;
        border: 1px solid #ddd;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        padding: 0;
        width: 100%;
        max-width: 600px;
        color: #eee;
        overflow: hidden;
    }

    summary.mission-header {
        cursor: pointer;
        font-size: 18px;
        padding: 20px;
        text-align: center;
        list-style: none;
        user-select: none;
    }

    summary.mission-header::-webkit-details-marker {
        display: none;
    }

    .mission-details {
        padding: 0 20px 20px 20px;
        font-size: 16px;
    }

    .mission-details ul {
        padding-left: 20px;
    }

    .mission-details li {
        margin-bottom: 8px;
    }

    button {
        margin-top: 15px;
        padding: 8px 16px;
        border: none;
        background-color: #28a745;
        color: white;
        border-radius: 8px;
        cursor: pointer;
    }

    button:hover {
        background-color: #218838;
    }

    .mission-details form {
        display: flex;
        justify-content: center;
    }

    .result-box {
        min-height: 60px;
        margin-top: 20px;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        font-weight: bold;
        font-size: 18px;
    }

    .result-box.success {
        background-color: #d4edda;
        color: #155724;
        border: 2px solid #c3e6cb;
    }

    .result-box.failure {
        background-color: #f8d7da;
        color: #721c24;
        border: 2px solid #f5c6cb;
    }
</style>
<script>
    document.querySelectorAll("details.mission-block").forEach(d => {
        d.addEventListener("toggle", () => {
            if (!d.open) {
                // Redirection "propre" sans missionId
                window.location.href = window.location.pathname;
            }
        });
    });
</script>